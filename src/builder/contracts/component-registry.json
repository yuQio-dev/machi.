          "center": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90,
                "default": 35.978
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "default": 140.147
              }
            },
            "required": [
              "lat",
              "lon"
