{
  "registryVersion": 1,
  "valueTypes": {
    "place-id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "screen-id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "string": {
      "type": "string",
      "maxLength": 1000,
      "default": ""
    },
    "boolean": {
      "type": "boolean"
    },
    "url": {
      "type": "string",
      "maxLength": 2048,
      "default": ""
    },
    "filter-value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "maxItems": 50,
          "minItems": 0
        }
      ]
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "operator": {
            "enum": [
              "eq",
              "in",
              "contains",
              "range"
            ],
            "default": "eq"
          },
          "value": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "maxItems": 50,
                "minItems": 0
              }
            ]
          }
        },
        "required": [
          "field",
          "operator",
          "value"
        ],
        "additionalProperties": false
      },
      "maxItems": 50,
      "minItems": 0
    },
    "bounds": {
      "type": "object",
      "properties": {
        "north": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "default": 90
        },
        "south": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "default": -90
        },
        "east": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "default": 180
        },
        "west": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "default": -180
        }
      },
      "required": [
        "north",
        "south",
        "east",
        "west"
      ],
      "additionalProperties": false
    }
  },
  "components": [
    {
      "kind": "map-view",
