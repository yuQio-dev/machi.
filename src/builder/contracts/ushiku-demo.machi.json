{
  "$schema": "../project.schema.json",
  "format": "machi-design",
  "schemaVersion": 2,
  "id": "ushiku-demo",
  "title": "うしくスポットマップ",
  "description": "設計とAI編集の往復を説明する例。観光情報の正確性の検証ではありません。",
  "locale": "ja",
  "theme": {
    "accent": "#7952b3",
    "background": "#f6f3fb",
    "foreground": "#332b43"
  },
  "responsive": {
    "mobileBelow": 768
  },
  "initialScreenId": "main",
  "datasets": [
    {
      "id": "ushiku",
      "name": "牛久市のサンプル3地点",
      "columns": [
        {
          "key": "name",
          "label": "スポット名",
          "type": "string",
          "visibility": "public"
        },
        {
          "key": "lat",
          "label": "緯度",
          "type": "number",
          "visibility": "public"
        },
        {
          "key": "lon",
          "label": "経度",
          "type": "number",
          "visibility": "public"
        },
        {
          "key": "location",
          "label": "住所",
          "type": "string",
          "visibility": "public"
        },
        {
          "key": "category",
          "label": "カテゴリ",
          "type": "string",
          "visibility": "public"
        },
        {
          "key": "description",
          "label": "紹介文",
          "type": "string",
          "visibility": "public"
        },
        {
          "key": "image",
          "label": "写真URL",
          "type": "string",
          "visibility": "public"
        },
        {
          "key": "sourceUrl",
          "label": "Webサイト",
          "type": "string",
          "visibility": "public"
        }
      ],
      "mapping": {
        "name": "name",
        "lat": "lat",
        "lon": "lon",
        "location": "location",
        "category": "category",
        "description": "description",
        "image": "image",
        "sourceUrl": "sourceUrl"
      },
      "rows": [
        {
          "id": "ushiku-1",
          "values": {
            "name": "牛久シャトー",
            "lat": 35.97802056,
            "lon": 140.1473454,
            "location": "茨城県牛久市中央3-20-1",
            "category": "ワイン醸造所",
            "description": "明治時代に誕生した日本初の本格的ワイン醸造所で、赤レンガ造りの美しい景観からロケ地としても人気のスポット。",
            "image": "https://yuqio-dev.github.io/ushiku-map/images/%E7%89%9B%E4%B9%85%E3%82%B7%E3%83%A3%E3%83%88%E3%83%BC.jpg",
            "sourceUrl": "https://www.ushikukankou.com/%E7%89%9B%E4%B9%85%E3%82%B7%E3%83%A3%E3%83%88%E3%83%BC/"
          }
        },
        {
          "id": "ushiku-2",
          "values": {
            "name": "手作処かっぱ本舗",
            "lat": 35.98645215,
            "lon": 140.1398715,
            "location": "茨城県牛久市田宮町45-10",
            "category": "お土産やさん",
            "description": "牛久沼のかっぱ伝説にちなんだお店で、牛久の名産品や手作りのせんべい・団子を楽しめる。",
            "image": "https://yuqio-dev.github.io/ushiku-map/images/%E6%89%8B%E4%BD%9C%E5%87%A6%E3%81%8B%E3%81%A3%E3%81%B1%E6%9C%AC%E8%88%97.jpg",
            "sourceUrl": "https://ushikukankou.com/kappahonpo.htm"
          }
        },
        {
          "id": "ushiku-3",
          "values": {
            "name": "牛久駅（JR常磐線）",
            "lat": 35.97575825,
            "lon": 140.141044,
            "location": "茨城県牛久市牛久町282",
            "category": "交通",
            "description": "茨城県牛久市牛久町にある東日本旅客鉄道（JR東日本）常磐線の駅である。",
            "image": "https://yuqio-dev.github.io/ushiku-map/images/%E7%89%9B%E4%B9%85%E9%A7%85.jpeg",
            "sourceUrl": "https://escado.jp/ibarakijiman/"
          }
        }
      ],
      "searchMatch": "all",
      "filterMatch": "all",
      "source": {
        "kind": "inline",
        "label": "既存サンプルCSVの先頭3地点。内容の正確性は未検証。",
        "url": ""
      }
    }
