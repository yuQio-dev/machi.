{
  "name": "ushiku-map",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build-apps-script.mjs",
    "build:samples": "node scripts/build-builder-samples.mjs",
    "dev:sketch": "node scripts/prepare-sketch.mjs && vite --config src/builder/vite.config.ts",
    "build:sketch": "node scripts/prepare-sketch.mjs && tsc -p src/builder/tsconfig.json && vite build --config src/builder/vite.config.ts && node scripts/build-map-viewer.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-moveable": "0.56.0",
    "react-resizable-panels": "4.14.8",
    "react-selecto": "1.26.3"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
